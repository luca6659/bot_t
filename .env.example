# Секреты только здесь. Файл .env не коммитить.

# Токен бота от @BotFather
BOT_TOKEN=123456:replace_me

# ID закрытой группы с темами, где работают админы. Узнать: добавить бота и написать /chatid
ADMIN_GROUP_ID=-1001234567890

# PostgreSQL. Если пусто, для локального запуска используется встроенная база в папке .data
DATABASE_URL=

# Публичный адрес сервера для webhook. Если пусто, бот работает через long polling
WEBHOOK_URL=
# Случайная строка: защищает webhook от чужих запросов
WEBHOOK_SECRET=
# Порт HTTP-сервера (облако обычно задаёт его само)
PORT=3000

LOG_LEVEL=info
NODE_ENV=development
