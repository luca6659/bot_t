{
  "name": "3d-toys-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram-бот для продажи 3D-игрушек на grammY",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/runner": "^2.0.3",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
